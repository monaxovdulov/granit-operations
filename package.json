{
  "name": "granit-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm -w @granit/manager run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w @granit/manager run typecheck",
    "test": "vitest run",
    "smoke:api": "vitest run apps/api/test/public-intake.test.ts",
    "seed:manager-user": "tsx apps/api/src/scripts/seed-manager-user.ts",
    "deliver:telegram:once": "tsx apps/api/src/scripts/deliver-telegram-pending-once.ts",
    "dev:api": "tsx apps/api/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
