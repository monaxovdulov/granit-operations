{
  "name": "granit-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run check:architecture && npm run typecheck && npm -w @granit/manager run build",
    "check:architecture": "node tooling/ai-architecture-guardrails.mjs && node --test tooling/ai-architecture-guardrails.test.mjs",
    "build:catalog-knowledge": "tsx apps/api/src/scripts/build-catalog-knowledge.ts",
    "typecheck": "npm run typecheck:api && npm -w @granit/manager run typecheck",
    "typecheck:api": "node tooling/typecheck-bounded.mjs",
    "test": "vitest run",
    "test:widget-ai:postgres": "vitest run apps/api/test/widget-ai-postgres-runtime-invariants.test.ts --maxWorkers=1",
    "smoke:api": "vitest run apps/api/test/public-intake.test.ts",
    "eval:widget-ai:offline": "vitest run apps/api/test/widget-ai-eval.test.ts",
    "eval:widget-ai:live": "tsx apps/api/src/scripts/run-widget-ai-evals.ts",
    "eval:widget-ai:dry-run": "tsx apps/api/src/scripts/run-widget-ai-evals.ts --dry-run",
    "seed:manager-user": "tsx apps/api/src/scripts/seed-manager-user.ts",
    "deliver:telegram:once": "tsx apps/api/src/scripts/deliver-telegram-pending-once.ts",
    "deliver:telegram:worker": "tsx apps/api/src/scripts/deliver-telegram-worker.ts",
    "deliver:manager-notifications:once": "tsx apps/api/src/scripts/deliver-manager-notifications-once.ts",
    "dev:api": "tsx apps/api/src/index.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
