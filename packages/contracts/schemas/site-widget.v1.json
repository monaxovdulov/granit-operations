{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granit-operations.local/contracts/public-intake/site_widget.v1.json",
  "title": "Granit public intake contract for site_widget.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "idempotency_key",
    "submitted_at",
    "source",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "site_widget.v1"
    },
    "event_type": {
      "const": "site_widget.message_submitted"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "page_url", "widget_instance_id"],
      "properties": {
        "channel": {
          "const": "site_widget"
        },
        "page_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "widget_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "page_title": {
          "type": "string",
          "maxLength": 240
        },
        "referrer_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "utm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "maxLength": 160 },
            "medium": { "type": "string", "maxLength": 160 },
            "campaign": { "type": "string", "maxLength": 160 },
            "term": { "type": "string", "maxLength": 160 },
            "content": { "type": "string", "maxLength": 160 }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "preferred_contact": {
          "enum": ["phone", "whatsapp", "telegram", "email"]
        },
        "city": { "type": "string", "maxLength": 120 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text"],
      "properties": {
        "role": {
          "const": "visitor"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "visitor_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "maxLength": 32 },
        "timezone": { "type": "string", "maxLength": 80 }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy_policy": { "type": "boolean" }
      }
    }
  }
}
