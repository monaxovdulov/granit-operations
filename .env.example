# Safe local defaults. The application does not load this file automatically.
NODE_ENV=development
DEPLOYMENT_TIER=local
HOST=127.0.0.1
PORT=3001

# Local PostgreSQL only. Replace this value for your own local installation.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/granit_operations

# Empty means no cross-origin browser access.
PUBLIC_INTAKE_ALLOWED_ORIGINS=

# External side effects stay disabled.
AI_WIDGET_ENABLED=false
AI_WIDGET_JOB_WORKER_ENABLED=false
TELEGRAM_BOT_ENABLED=false
